# Copy this file to .env and fill in your own keys. Never commit .env.
# Providers are tried in this order. Remove one from the list to switch it off.
PROVIDER_ORDER=groq,gemini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview

REQUEST_TIMEOUT_SECONDS=25
MAX_RETRIES=2

# Lab files and rules
DATA_DIR=lab_reports
# true = ask for age and sex whenever one is missing (lab safety rule 3)
STRICT_DEMOGRAPHICS=true
LOG_LEVEL=INFO

# Speed, safety and cost
REASONING_EFFORT=low
LLM_DEADLINE_SECONDS=22
LLM_MAX_CALLS_PER_HOUR=1500
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0
RATE_ANALYZE_PER_MIN=600
RATE_CHAT_PER_MIN=600
RATE_TTS_PER_MIN=120
RATE_STT_PER_MIN=90

# Voice
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_UR=ur-PK-UzmaNeural
TTS_RATE=-8%
# fast English voice on Groq, needs the model terms accepted once in the Groq console
TTS_ENGLISH_PROVIDER=edge
