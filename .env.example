# Copy this file to .env and fill in your own keys. Never commit .env.
# Providers are tried in this order. Remove one from the list to switch it off.
PROVIDER_ORDER=groq,gemini

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview

REQUEST_TIMEOUT_SECONDS=25
MAX_RETRIES=2

# Lab files and rules
DATA_DIR=lab_reports
# true = ask for age and sex whenever one is missing (lab safety rule 3)
STRICT_DEMOGRAPHICS=true
LOG_LEVEL=INFO
